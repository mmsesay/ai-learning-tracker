# Copy to .env (never commit .env)

# Remote DevAssist MCP (Streamable HTTP on Render)
DEVASSIST_URL=https://ai-learning-tracker-c7m5.onrender.com/mcp
DEVASSIST_API_KEY=

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Prefer a tool-capable free model
OPENAI_MODEL=google/gemma-4-26b-a4b-it:free

# Cap agent loop iterations (model call + optional tool round)
MAX_STEPS=6
