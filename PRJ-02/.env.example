# Copy to .env (never commit .env)

# OpenAI-compatible provider (OpenRouter works the same way as PRJ-01)
OPENAI_API_KEY=
# Or OpenRouter:
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini

# SQLite checkpoint DB path (created automatically)
LEPA_CHECKPOINT_PATH=./data/checkpoints.sqlite
