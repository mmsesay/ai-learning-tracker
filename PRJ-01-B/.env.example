# DevAssist MCP — copy to .env and fill in values (never commit .env)

# HTTP bind (Railway sets PORT automatically)
PORT=3000
HOST=0.0.0.0

# streamable-http (remote / Railway) or stdio (local Cursor subprocess)
TRANSPORT=streamable-http

# Folder that contains your projects (list_projects scans its children)
# On Railway demo: set to the absolute path of demo_workspace inside the container
# e.g. /app/demo_workspace  (depends on Railway root / start cwd)
WORKSPACE_ROOT=./demo_workspace

# Required when HOST=0.0.0.0 (Railway). Leave empty only for HOST=127.0.0.1 local HTTP.
API_KEY=

# After Railway gives you a domain, set both forms (recommended):
# MCP_ALLOWED_HOSTS=your-app.up.railway.app,your-app.up.railway.app:*
MCP_ALLOWED_HOSTS=
