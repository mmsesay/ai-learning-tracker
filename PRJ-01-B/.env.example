# DevAssist MCP — copy to .env and fill in values (never commit .env)

# HTTP bind (Render sets PORT automatically)
PORT=3000
HOST=0.0.0.0

# streamable-http (remote / Render) or stdio (local Cursor subprocess)
TRANSPORT=streamable-http

# Folder that contains your projects (list_projects scans its children)
# On Render demo: WORKSPACE_ROOT=demo_workspace (relative to PRJ-01-B root)
WORKSPACE_ROOT=./demo_workspace

# Required when HOST=0.0.0.0 (Render). Leave empty only for HOST=127.0.0.1 local HTTP.
API_KEY=

# After Render gives you a domain, set both forms (recommended):
# MCP_ALLOWED_HOSTS=your-app.onrender.com,your-app.onrender.com:*
MCP_ALLOWED_HOSTS=
