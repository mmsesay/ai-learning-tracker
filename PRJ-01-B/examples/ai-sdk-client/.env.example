# Copy to .env (never commit .env)

# Remote DevAssist MCP (Streamable HTTP)
DEVASSIST_URL=https://ai-learning-tracker-c7m5.onrender.com/mcp
DEVASSIST_API_KEY=

# Model provider (pick one)
# Option A — OpenAI
OPENAI_API_KEY=
# Option B — OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Prefer a tool-capable free model (openrouter/free is flaky with MCP tool rounds)
OPENAI_MODEL=google/gemma-4-26b-a4b-it:free
