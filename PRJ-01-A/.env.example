# OpenRouter (recommended for free models — no OpenAI billing)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Free Models Router: auto-picks a free model that supports tool calling
OPENAI_MODEL=openrouter/free
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Or pin a specific free model (examples — check https://openrouter.ai/models?q=free)
# OPENAI_MODEL=google/gemma-4-26b-a4b-it:free
# OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
